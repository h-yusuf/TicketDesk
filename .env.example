# All optional. If unset, the corresponding integration's hook in
# pocketbase/pb_hooks/reqflow.pb.js no-ops silently — request create/
# update always succeeds either way.

# Discord bot (not a webhook) — must be invited to the target server
# with permission to send messages in DISCORD_HOME_CHANNEL.
DISCORD_BOT_TOKEN=
DISCORD_HOME_CHANNEL=

# Notion integration token, shared with the target database.
# Database must have these properties: "Nama tugas" (title),
# "Deskripsi" (rich_text), "Status" (status, incl. a "New Request"
# option), "Prioritas" (select: Low/Medium/High), "No" (rich_text).
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Only needed for direct IP:port testing without a domain reverse proxy.
# VITE_POCKETBASE_URL=
